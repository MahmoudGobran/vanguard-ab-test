              <calculation class='tableau' formula='IF [clnt_age] &gt;= 65 THEN &quot;65+&quot;&#13;&#10;ELSEIF [clnt_age] &gt;= 55 THEN &quot;55-64&quot;&#13;&#10;ELSEIF [clnt_age] &gt;= 45 THEN &quot;45-54&quot;&#13;&#10;ELSEIF [clnt_age] &gt;= 35 THEN &quot;35-44&quot;&#13;&#10;ELSEIF [clnt_age] &gt;= 25 THEN &quot;25-34&quot;&#13;&#10;ELSEIF [clnt_age] &gt;= 18 THEN &quot;18-24&quot;&#13;&#10;ELSE &quot;Unknown/Other&quot; // Or handle as you prefer for ages below 18, though unlikely in client data&#13;&#10;END' />
