        <column caption='age_band' datatype='string' name='[Calculation_666532772434882565]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [clnt_age] &gt;= 65 THEN &quot;65+&quot;&#13;&#10;ELSEIF [clnt_age] &gt;= 55 THEN &quot;55-64&quot;&#13;&#10;ELSEIF [clnt_age] &gt;= 45 THEN &quot;45-54&quot;&#13;&#10;ELSEIF [clnt_age] &gt;= 35 THEN &quot;35-44&quot;&#13;&#10;ELSEIF [clnt_age] &gt;= 25 THEN &quot;25-34&quot;&#13;&#10;ELSEIF [clnt_age] &gt;= 18 THEN &quot;18-24&quot;&#13;&#10;ELSE &quot;Unknown/Other&quot; // Or handle as you prefer for ages below 18, though unlikely in client data&#13;&#10;END' />
        </column>
        <column caption='tenure_band' datatype='string' name='[Calculation_666532772435562502]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [clnt_tenure_yr] &gt;= 10 THEN &quot;10+ Yrs&quot;&#13;&#10;ELSEIF [clnt_tenure_yr] &gt;= 5 THEN &quot;5-10 Yrs&quot;&#13;&#10;ELSEIF [clnt_tenure_yr] &gt;= 1 THEN &quot;1-5 Yrs&quot;&#13;&#10;ELSEIF [clnt_tenure_yr] &gt;= 0 THEN &quot;&lt;1 Yr&quot;&#13;&#10;ELSE &quot;Unknown/Other&quot;&#13;&#10;END' />
        </column>
        <column caption='num_accts_band' datatype='string' name='[Calculation_666532772435689479]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [num_accts] &gt;= 7 THEN &quot;7+ Accounts&quot; // Assuming &quot;7+&quot; implies 7 or more from your bins. If 6+, use &gt;=6&#13;&#10;ELSEIF [num_accts] &gt;= 4 THEN &quot;4-6 Accounts&quot;&#13;&#10;ELSEIF [num_accts] &gt;= 2 THEN &quot;2-3 Accounts&quot;&#13;&#10;ELSEIF [num_accts] &gt;= 1 THEN &quot;1 Account&quot;&#13;&#10;ELSE &quot;Unknown/Other&quot;&#13;&#10;END' />
        </column>
        <column caption='logons_band' datatype='string' name='[Calculation_666532772435914760]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [logons_6_mnth] &gt;= 30 THEN &quot;30+&quot;&#13;&#10;ELSEIF [logons_6_mnth] &gt;= 15 THEN &quot;15-29&quot;&#13;&#10;ELSEIF [logons_6_mnth] &gt;= 5 THEN &quot;5-14&quot;&#13;&#10;ELSEIF [logons_6_mnth] &gt;= 1 THEN &quot;1-4&quot;&#13;&#10;ELSEIF [logons_6_mnth] = 0 THEN &quot;0&quot;&#13;&#10;ELSE &quot;Unknown/Other&quot;&#13;&#10;END' />
        </column>
